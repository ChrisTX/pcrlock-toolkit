# Make the password prompt infinite
rd.luks.options=timeout=0
rootflags=x-systemd.device-timeout=0

# Lock down systemd-gpt-auto-generator and systemd FACTORY_RESET mechanisms.
# The image policy only applies to root with root=dissect(-force); test-boot
# with a fallback entry first (see README).
root=dissect-force
mount.usr=off
systemd.image_policy=root=encrypted+read-only-off:esp=unprotected+vfat:=absent+unused
systemd.factory_reset=0
systemd.tpm2_allow_clear=0

# No first-boot prompts (root password, homed user), even if first boot is
# forced with systemd.condition_first_boot=; the masks can't be undone later
systemd.firstboot=off
systemd.mask=systemd-firstboot.service
systemd.mask=systemd-homed-firstboot.service

# No extensions merged in the initrd (they come from the unencrypted ESP), and
# no credentials with a "null" key, not even without a TPM
rd.systemd.sysext=0
rd.systemd.confext=0
systemd.credentials_boot_policy=strict

# Force enable AppArmor, lockdown (integrity) and signature enforcment
lsm=landlock,lockdown,yama,integrity,apparmor,bpf
apparmor=1
lockdown=integrity
module.sig_enforce=1

# Force strict IOMMU for both AMD and Intel CPUs
iommu.passthrough=0
iommu.strict=1
amd_iommu=force_isolation,pgtbl_v2
intel_iommu=on

# Various hardening settings, see KSPP and kernel-hardening-checker
bdev_allow_write_mounted=0
cfi=kcfi
debugfs=off
efi=disable_early_pci_dma
hardened_usercopy=1
hash_pointers=always
init_on_alloc=1
page_alloc.shuffle=1
proc_mem.force_override=never
randomize_kstack_offset=1
slab_nomerge
vsyscall=none

# Additionally, but with a 2-5% performance hit
# init_on_free=1

# SLUB red zoning, severe performance hit
# slub_debug=ZF

# Sysctls applied before PID 1 starts (signed + measured as part of the UKI).
# Only settings systemd's own sysctl.d files don't touch - anything they do
# set would be overwritten later by systemd-sysctl, those stay in sysctl.d.
# One-way: cannot be undone at runtime once set
sysctl.kernel.kexec_load_disabled=1
sysctl.kernel.unprivileged_bpf_disabled=1
# Full ASLR entropy for the initrd and PID 1, not just later processes
sysctl.vm.mmap_rnd_bits=32
sysctl.vm.mmap_rnd_compat_bits=16
# Early-boot hygiene
sysctl.kernel.kptr_restrict=2
sysctl.kernel.dmesg_restrict=1
sysctl.kernel.yama.ptrace_scope=2
sysctl.kernel.perf_event_paranoid=2
sysctl.dev.tty.ldisc_autoload=0
sysctl.dev.tty.legacy_tiocsti=0
sysctl.kernel.oops_limit=1
sysctl.kernel.warn_limit=100

# Enable EFI as PSTORE backend
efi_pstore.pstore_disable=0

# Reboot 10s after a panic instead of hanging (oops log is kept via efi-pstore)
panic=10
# The same when PID 1 crashes, instead of freezing with decrypted memory
systemd.crash_action=reboot

# Audit limits
audit=1
audit_backlog_limit=8192

# Disable emergency.target and shell to prevent access to the UKI
rd.shell=0
rd.emergency=reboot
# No debug shell, in the initrd or on the host; a later parameter can't undo a mask
rd.systemd.mask=debug-shell.service
systemd.mask=debug-shell.service

quiet
splash
