#  After `pcrlock suspend-firmware`, lock the firmware PCRs again on the next
#  boot: regenerate their components from this boot's event log (the updated
#  firmware) and rebuild the full policy. Must be enabled before suspending,
#  which `pcrlock suspend-firmware` checks.
#
#  Ordered after systemd-pcrlock-make-policy.service, which runs first with the
#  stale firmware components and fails under --strict=yes (the suspended
#  policy then stays in place until this unit replaces it). Restarting that
#  unit from here is safe since it doesn't wait for this one.
#
#  If a component can't be regenerated (e.g. hand-made variants), this unit
#  fails and the PCRs stay suspended; `pcrlock list` keeps warning about it.

[Unit]
Description=Lock firmware PCRs again after a firmware update
Documentation=file:///usr/share/doc/pcrlock-toolkit/README.md
DefaultDependencies=no
Conflicts=shutdown.target
After=systemd-pcrlock-make-policy.service pcrlock-prune.service
After=systemd-remount-fs.service var.mount
Before=sysinit.target shutdown.target
ConditionPathExists=!/etc/initrd-release
ConditionPathExists=/var/lib/pcrlock-toolkit/firmware-suspended

[Service]
Type=oneshot
RemainAfterExit=yes
# /tmp may not be mounted yet this early.
RuntimeDirectory=pcrlock-toolkit-relock
Environment=TMPDIR=%t/pcrlock-toolkit-relock
ExecStart=/usr/bin/pcrlock relock-firmware

[Install]
WantedBy=sysinit.target
