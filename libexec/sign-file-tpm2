#!/bin/sh
# sign-file-tpm2: DKMS module signing with a TPM2-held key via tpm2-openssl.
#
# DKMS's sign_file, set in /etc/dkms/framework.conf.d/mok-signing.conf
# (example in /usr/share/pcrlock-toolkit/examples/dkms/):
#   sign_file="/usr/lib/pcrlock-toolkit/sign-file-tpm2"
# The OpenSSL config only loads the default and tpm2 providers; override its
# path with SIGN_FILE_TPM2_OPENSSL_CONF if needed.
export OPENSSL_CONF="${SIGN_FILE_TPM2_OPENSSL_CONF:-/etc/pcrlock-toolkit/openssl-tpm2.cnf}"
shift # drop the hash DKMS passes (sha512)
exec /usr/lib/modules/"${kernelver:-$(uname -r)}"/build/scripts/sign-file sha384 "$@"
