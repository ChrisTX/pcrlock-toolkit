#!/usr/bin/bash
# pcrlock - generate and maintain systemd-pcrlock components from a declarative
# configuration. Part of pcrlock-toolkit.
#
# Components are described by files in /etc/pcrlock-toolkit/components.d/,
# named <priority>-<name>.conf. Each produces <priority>-<name>.pcrlock in
# /etc/pcrlock.d (or, with KeepPrevious=yes, a <priority>-<name>.pcrlock.d/
# directory holding the current variant and the one the system booted with).
# See pcrlock --help and the README for the available component types.
set -euo pipefail
shopt -s nullglob

readonly PROG=${0##*/}
readonly VERSION=0.1.0
readonly PCRLOCK=/usr/lib/systemd/systemd-pcrlock
readonly CEL_DECODE=/usr/lib/pcrlock-toolkit/cel-decode
readonly CRYPTTAB=/etc/crypttab
readonly MAKE_POLICY_UNIT=systemd-pcrlock-make-policy.service
# make-policy builds one PolicyOR per PCR, and TPM2_PolicyOR takes at most 8
# branches.
readonly MAX_PCR_VALUES=8
# systemd-pcrlock's defaults for make-policy --location= and --pcr=.
readonly PCRLOCK_DEFAULT_LOCATION=760-:940-
readonly DEFAULT_PCRS=0-5,7,11,13-15
# suspend-firmware: a runtime drop-in for the make-policy unit (named to sort
# after users' own drop-ins, which may set ExecStart= too), and the state file
# that survives the reboot until the firmware PCRs are locked again.
readonly SUSPEND_DROPIN=/run/systemd/system/$MAKE_POLICY_UNIT.d/zz-pcrlock-toolkit-suspend-firmware.conf
readonly SUSPEND_STATE=/var/lib/pcrlock-toolkit/firmware-suspended
readonly RELOCK_UNIT=pcrlock-firmware-relock.service
# suspend-firmware --if-capsule-pending: the staged capsule update that was
# last suspended for, so a stale one doesn't suspend again on every boot.
readonly CAPSULE_STATE=/var/lib/pcrlock-toolkit/capsule-suspended
readonly EFIVARS=/sys/firmware/efi/efivars
# fwupd's vendor GUID for its update info variables, and the EFI global one.
readonly FWUPD_GUID=0abba7dc-e516-4167-bbf5-4d9d1c739416
readonly EFI_GLOBAL_GUID=8be4df61-93ca-11d2-aa0d-00e098032b8c
readonly SHIM_LOCK_GUID=605dab50-e046-4300-abb6-3dd810dd8b23
# shim's SBAT_VAR_ORIGINAL, the shortest valid SbatLevel.
readonly SBAT_ORIGINAL=$'sbat,1,2021030218\n'

config_dir=/etc/pcrlock-toolkit

# Global settings, overridable in pcrlock.conf.
opt_dir=/etc/pcrlock.d
opt_policy=now
opt_uki_component=650-uki
opt_suspend_pcrs=0-3
# The window make-policy must use: from 791 on, i.e. after mor-lock (785) and
# platsec (790), so the policy never unlocks anything before those measured.
opt_location=791:940-

dry_run=0
verbose=0
policy_cli=
type_filter=
changed=0
no_apply=0
if_capsule_pending=0
capsule_fp=
# Set by make_policy_argv.
mp_argv=()
mp_pcrs=()
mp_location=
tmp=
CEL=

usage() {
    cat <<EOF
Usage: $PROG [OPTIONS] COMMAND [ARGS...]

Generate and maintain systemd-pcrlock components from $config_dir.

Commands:
  generate [NAME...]       Generate all enabled components, or only the named
                           ones, and update the policy if anything changed.
  list                     Show configured components and their state.
  prune                    Remove '-previous' variants that don't match the
                           current boot, and UKI components of kernels that
                           are no longer installed.
  uki add KVER UKI [KERNEL]
                           Lock a UKI (and the kernel image it loads) as
                           variant KVER (the kernel version) of the UKI
                           component. Used by the kernel-install plugin.
  uki remove KVER          Remove the UKI variant KVER, unless it is the
                           running one (prune removes that after reboot).
  check                    Show how many values each PCR can take in the
                           policy (at most $MAX_PCR_VALUES), and whether
                           make-policy uses --location=$opt_location (Location=
                           in pcrlock.conf). Both are checked before every
                           policy update.
  suspend-firmware [PCRS]  Take the firmware PCRs (default: SuspendPCRs= in
                           pcrlock.conf, else $opt_suspend_pcrs) out of the
                           policy until the next boot, for a firmware update.
                           With --if-capsule-pending, only if fwupd staged a
                           UEFI capsule (run by pcrlock-firmware-suspend.path).
  relock-firmware         Lock them again: regenerate their components from
                           the event log and rebuild the full policy. Run by
                           $RELOCK_UNIT on the next boot.
  decode [--text] [--pcr=PCRS] [FILE|-]
                           Decode the event data of the TPM event log (or of
                           CEL JSON / a .pcrlock file): variables, signature
                           lists and certificates, boot options, device paths.
  volume-keys              Show the volume keys measured this boot, the
                           fixate-volume-key= value for each and whether
                           $CRYPTTAB has it.

Options:
  --type=TYPE[,TYPE...]    generate: only components of these types.
  --policy=now|mark|none   How to update the policy after changes:
                           now:  restart $MAKE_POLICY_UNIT
                           mark: mark it for restart (pacman's restart-marked hook)
                           none: leave it to you
                           Default: Policy= in pcrlock.conf, else "now".
  --if-capsule-pending     suspend-firmware: do nothing unless a UEFI capsule
                           update is staged and wasn't suspended for yet.
  --dry-run                Show what would change without writing anything.
  --config-dir=DIR         Configuration directory (default: $config_dir).
  -v, --verbose            More output.
  -h, --help               Show this help.
  --version                Show the version.

Component types (Type= in components.d/*.conf):
  pe          lock-pe of an EFI binary                      Path=
  log         records from the current event log            PCR= [EventTypes=] [Filter=]
  volume-key  cryptsetup volume key measurement             Volume= [PCR=15]
  identity    machine-id + file systems, merged             [MountPoints=/]
  raw         fixed string, like systemd-pcrextend          PCR= Text=
  platsec     current output of platsec-pcr-check --status  [PCR=]
  copy        copy of an existing .pcrlock file             Source=
  secureboot-policy
              lock-secureboot-policy (PCR 7); only dbx may
              differ from the current boot
  secureboot-authority
              lock-secureboot-authority (PCR 7), with the       [Path=]
              SbatLevel the shim at Path= will set
Common keys: Enabled=, Output=, KeepPrevious=, MinRecords=
EOF
}

die() { echo "$PROG: $*" >&2; exit 1; }
warn() { echo "$PROG: warning: $*" >&2; }
log() { echo "$PROG: $*"; }
debug() { if ((verbose)); then echo "$PROG: $*" >&2; fi; }

is_yes() {
    case ${1,,} in
    yes | true | on | 1) return 0 ;;
    no | false | off | 0) return 1 ;;
    *) die "invalid boolean '$1'" ;;
    esac
}

# parse_kv_file FILE CALLBACK
# Plain Key=Value lines; '#' starts a comment only at the beginning of a line
# (values such as jq filters may contain '#'). Optional quotes around the value
# are stripped. Calls CALLBACK KEY VALUE LOCATION for each entry.
parse_kv_file() {
    local file=$1 cb=$2 line key val n=0
    while IFS= read -r line || [[ -n $line ]]; do
        n=$((n + 1))
        line=${line#"${line%%[![:space:]]*}"}
        line=${line%"${line##*[![:space:]]}"}
        [[ -z $line || $line == \#* ]] && continue
        [[ $line == *=* ]] || die "$file:$n: expected Key=Value"
        key=${line%%=*}
        val=${line#*=}
        key=${key%"${key##*[![:space:]]}"}
        val=${val#"${val%%[![:space:]]*}"}
        if [[ ${#val} -ge 2 && ( ($val == \"*\") || ($val == \'*\') ) ]]; then
            val=${val:1:${#val}-2}
        fi
        "$cb" "$key" "$val" "$file:$n"
    done <"$file"
}

global_kv() {
    case $1 in
    Directory) opt_dir=$2 ;;
    Policy) opt_policy=$2 ;;
    UkiComponent) opt_uki_component=$2 ;;
    SuspendPCRs) opt_suspend_pcrs=$2 ;;
    Location) opt_location=$2 ;;
    *) die "$3: unknown key '$1'" ;;
    esac
}

load_global() {
    local f=$config_dir/pcrlock.conf
    if [[ -e $f ]]; then
        parse_kv_file "$f" global_kv
    fi
    case $opt_policy in now | mark | none) ;; *) die "$f: Policy= must be now, mark or none" ;; esac
    [[ $opt_dir == /* ]] || die "$f: Directory= must be an absolute path"
    [[ $opt_location =~ ^[^[:space:]]+$ ]] || die "$f: Location= must be a --location= value such as 791:940-"
}

# ---------------------------------------------------------------------------
# Components

reset_component() {
    c_type='' c_enabled=yes c_path='' c_pcr='' c_text='' c_event_types='' c_filter=''
    c_min_records=1 c_volume='' c_mounts=/ c_source='' c_output='' c_keep_previous=''
}

component_kv() {
    case $1 in
    Type) c_type=$2 ;;
    Enabled) c_enabled=$2 ;;
    Path) c_path=$2 ;;
    PCR) c_pcr=$2 ;;
    Text) c_text=$2 ;;
    EventTypes) c_event_types=$2 ;;
    Filter) c_filter=$2 ;;
    MinRecords) c_min_records=$2 ;;
    Volume) c_volume=$2 ;;
    MountPoints) c_mounts=$2 ;;
    Source) c_source=$2 ;;
    Output) c_output=$2 ;;
    KeepPrevious) c_keep_previous=$2 ;;
    *) die "$3: unknown key '$1'" ;;
    esac
}

# load_component FILE: sets c_* for the component described by FILE.
load_component() {
    local f=$1 base
    base=${f##*/}
    base=${base%.conf}
    [[ $base =~ ^([0-9]+)-([A-Za-z0-9_.-]+)$ ]] ||
        die "$f: file name must be <priority>-<name>.conf"
    c_prio=${BASH_REMATCH[1]}
    c_name=${BASH_REMATCH[2]}
    c_file=$f
    reset_component
    parse_kv_file "$f" component_kv

    case $c_type in
    pe | secureboot-policy | secureboot-authority) : "${c_keep_previous:=yes}" ;;
    log | volume-key | identity | raw | platsec | copy) : "${c_keep_previous:=no}" ;;
    '') die "$f: Type= missing" ;;
    *) die "$f: unknown Type '$c_type'" ;;
    esac
    is_yes "$c_enabled" >/dev/null || true
    is_yes "$c_keep_previous" >/dev/null || true
    [[ -z $c_pcr || $c_pcr =~ ^[0-9]+$ ]] || die "$f: PCR= must be a number"
    [[ $c_min_records =~ ^[0-9]+$ ]] || die "$f: MinRecords= must be a number"
}

component_target() {
    if [[ -n $c_output ]]; then
        if [[ $c_output == /* ]]; then
            printf '%s\n' "$c_output"
        else
            printf '%s\n' "$opt_dir/$c_output"
        fi
    elif is_yes "$c_keep_previous"; then
        printf '%s\n' "$opt_dir/$c_prio-$c_name.pcrlock.d/$c_name.pcrlock"
    else
        printf '%s\n' "$opt_dir/$c_prio-$c_name.pcrlock"
    fi
}

ensure_cel() {
    if [[ ! -s $CEL ]]; then
        "$PCRLOCK" cel >"$CEL" || die "failed to read the TPM event log"
    fi
}

# is_booted FILE: does this component variant match the current boot?
# If the variant has PCR 4 records (boot loaders, UKIs, kernels), only those
# are compared, since they identify the binary that ran. Otherwise every record
# must appear in the event log.
is_booted() {
    ensure_cel
    jq -e --slurpfile cel "$CEL" '
        [.records[]? | select(.pcr != null)] as $all
        | (if any($all[]; .pcr == 4) then [$all[] | select(.pcr == 4)] else $all end) as $want
        | ($want | length) > 0
          and all($want[];
                  . as $w
                  | [$w.digests[]?.digest] as $d
                  | any($cel[0][]; .pcr == $w.pcr
                        and any(.digests[]?; .digest as $x | ($d | index($x)) != null)))
    ' "$1" >/dev/null 2>&1
}

gen_pe() {
    [[ -n $c_path ]] || die "$c_file: Path= missing"
    [[ -r $c_path ]] || die "$c_file: $c_path not readable"
    "$PCRLOCK" lock-pe "$c_path" --pcrlock="$1"
}

gen_log() {
    local out=$1 types_json prog
    local -a types
    [[ -n $c_pcr ]] || die "$c_file: PCR= missing"
    ensure_cel
    read -ra types <<<"$c_event_types"
    types_json=$(jq -nc '$ARGS.positional' --args "${types[@]}")
    # jq program text; $pcr/$types are jq variables, not shell ones.
    # shellcheck disable=SC2016
    prog='[.[] | select(.pcr == $pcr)'
    if ((${#types[@]})); then
        # shellcheck disable=SC2016
        prog+=' | select(.content.event_type as $t | ($types | index($t)) != null)'
    fi
    if [[ -n $c_filter ]]; then
        prog+=" | select($c_filter)"
    fi
    prog+='] | {records: map({pcr, digests, content})}'
    jq --argjson pcr "$c_pcr" --argjson types "$types_json" "$prog" "$CEL" >"$out" ||
        die "$c_file: filter failed"
}

gen_volume_key() {
    local out=$1 got
    [[ -n $c_volume ]] || die "$c_file: Volume= missing"
    ensure_cel
    jq --argjson pcr "${c_pcr:-15}" --arg vol "$c_volume" '
        {records: [.[]
            | select(.pcr == $pcr and .content.eventType == "volume-key")
            | select((.content.string | split(":")[1]) == $vol)
            | {pcr, digests, content}]}
    ' "$CEL" >"$out"
    got=$(jq '.records | length' "$out")
    ((got == 1)) || die "$c_name: expected 1 volume-key record for '$c_volume', found $got (was it unlocked via TPM this boot?)"
}

gen_identity() {
    local out=$1 i=0 mp f files=()
    local -a mounts
    read -ra mounts <<<"$c_mounts"
    "$PCRLOCK" lock-machine-id --pcrlock="$tmp/id-machine-id.pcrlock"
    files+=("$tmp/id-machine-id.pcrlock")
    for mp in "${mounts[@]}"; do
        i=$((i + 1))
        "$PCRLOCK" lock-file-system "$mp" --pcrlock="$tmp/id-fs-$i.pcrlock"
        files+=("$tmp/id-fs-$i.pcrlock")
    done
    jq -s '{records: map(.records[])}' "${files[@]}" >"$out"

    for f in /var/lib/pcrlock.d/820-machine-id.pcrlock \
        /var/lib/pcrlock.d/830-root-file-system.pcrlock \
        /var/lib/pcrlock.d/840-file-system-*.pcrlock; do
        if [[ -e $f ]]; then
            warn "$f duplicates component '$c_name'; remove it and disable systemd-pcrlock-machine-id.service / systemd-pcrlock-file-system.service"
        fi
    done
}

gen_raw() {
    [[ -n $c_pcr ]] || die "$c_file: PCR= missing"
    [[ -n $c_text ]] || die "$c_file: Text= missing"
    printf '%s' "$c_text" | "$PCRLOCK" lock-raw --pcr="$c_pcr" --pcrlock="$1"
}

gen_platsec() {
    local event pcr
    command -v platsec-pcr-check >/dev/null || die "platsec-pcr-check not found"
    if ! event=$(platsec-pcr-check --status); then
        die "$c_name: platform baseline not met ($event); refusing to lock a failing state"
    fi
    pcr=${c_pcr:-$(platsec-pcr-check --print-pcr)}
    printf '%s' "$event" | "$PCRLOCK" lock-raw --pcr="$pcr" --pcrlock="$1"
}

gen_secureboot_policy() {
    local out=$1 f
    "$PCRLOCK" lock-secureboot-policy --pcrlock="$out"
    ensure_cel
    # lock-secureboot-policy reads the current EFI variables, so after a dbx
    # update it predicts the next boot. Only dbx is allowed to differ from the
    # event log: a PK, KEK or db change isn't locked until a boot measured it.
    # The dbx record is UEFI_VARIABLE_DATA with the image security database
    # GUID, a name length of 3 and the name "dbx" (UTF-16LE).
    # shellcheck disable=SC2016
    jq -e --slurpfile cel "$CEL" '
        def sha256: [.digests[]? | select(.hashAlg == "sha256") | .digest] | first;
        def is_dbx: (.content.event_data // "")
            | startswith("cbb219d73a3d9645a3bcdad00e67656f0300000000000000")
              and .[64:76] == "640062007800";
        [$cel[0][] | select(.pcr == 7 and .content.event_type? == "EV_EFI_VARIABLE_DRIVER_CONFIG")] as $log
        | [.records[] | select(.pcr == 7)] as $new
        | ($log | length) > 0
          and ($log | length) == ($new | length)
          and all(range($log | length);
                  . as $i | ($log[$i] | is_dbx) or ($log[$i] | sha256) == ($new[$i] | sha256))
    ' "$out" >/dev/null ||
        die "$c_name: Secure Boot variables other than dbx differ from the current boot; only dbx updates are predicted (lock again after a reboot)"

    for f in /var/lib/pcrlock.d/*-secureboot-policy.pcrlock /var/lib/pcrlock.d/*-secureboot-policy.pcrlock.d; do
        warn "$f duplicates component '$c_name'; remove it and disable systemd-pcrlock-secureboot-policy.service"
    done
}

# read_uint FILE OFFSET SIZE: little-endian unsigned integer from a binary file.
read_uint() {
    od -An -tu"$3" -j "$2" -N "$3" -- "$1" | tr -d ' '
}

# pe_section FILE NAME OUT: writes the data of PE section NAME to OUT.
pe_section() {
    local f=$1 want=$2 out=$3 pe nsec off i name strtab
    pe=$(read_uint "$f" 60 4)
    [[ $(od -An -c -j "$pe" -N 4 -- "$f" | tr -d ' ') == 'PE\0\0' ]] || die "$f: not a PE binary"
    nsec=$(read_uint "$f" $((pe + 6)) 2)
    off=$((pe + 24 + $(read_uint "$f" $((pe + 20)) 2)))
    # Names longer than 8 bytes (such as .sbatlevel) are "/<offset>" into the
    # COFF string table, which follows the 18-byte symbol table entries.
    strtab=$(($(read_uint "$f" $((pe + 12)) 4) + 18 * $(read_uint "$f" $((pe + 16)) 4)))
    for ((i = 0; i < nsec; i++, off += 40)); do
        name=$(od -An -c -j "$off" -N 8 -- "$f" | tr -d ' ')
        name=${name%%\\0*}
        if [[ $name =~ ^/([0-9]+)$ ]]; then
            read_cstring "$f" $((strtab + BASH_REMATCH[1])) name
        fi
        [[ $name == "$want" ]] || continue
        # VirtualSize: the raw data is padded to the file alignment.
        dd if="$f" of="$out" bs=4096 iflag=skip_bytes,count_bytes status=none \
            skip="$(read_uint "$f" $((off + 20)) 4)" count="$(read_uint "$f" $((off + 8)) 4)"
        return 0
    done
    die "$f: no $want section"
}

# The SbatLevel helpers below return strings through a variable name, since
# command substitution would strip the trailing newline SbatLevel ends with.

# read_cstring FILE OFFSET VAR: sets VAR to the NUL-terminated string at OFFSET.
read_cstring() {
    IFS= read -r -d '' "$3" < <(tail -c +$(($2 + 1)) -- "$1") || true
}

# efivar_text NAME VAR: sets VAR to the data of an EFI variable (without the
# attributes), or fails if it doesn't exist.
efivar_text() {
    local f=$EFIVARS/$1 data
    [[ -r $f ]] || return 1
    data=$(tail -c +5 -- "$f"; printf x)
    printf -v "$2" '%s' "${data%x}"
}

# sbat_keeps CURRENT CANDIDATE: does shim keep the CURRENT SbatLevel instead of
# writing CANDIDATE? Mirrors preserve_sbat_uefi_variable(): a valid current
# level stays if its version is higher or its datestamp isn't older.
sbat_keeps() {
    local cur=$1 new=$2 cv cd nv nd
    [[ $cur == sbat,* && ${#cur} -ge ${#SBAT_ORIGINAL} ]] || return 1
    IFS=, read -r _ cv cd <<<"${cur%%$'\n'*}"
    IFS=, read -r _ nv nd <<<"${new%%$'\n'*}"
    if ((${#cv} > ${#nv})) || [[ ${#cv} -eq ${#nv} && $cv > "$nv" ]]; then
        return 0
    fi
    [[ ! ${cd:0:10} < "${nd:0:10}" ]]
}

# shim_next_sbat SHIM CURRENT VAR: sets VAR to the SbatLevel SHIM leaves behind on
# its next boot, from its .sbatlevel section (format version, then the
# offsets of the automatic and latest payloads relative to the offset table)
# and a pending SbatPolicy (1 latest, 2 automatic, 3 reset, which shim
# ignores with Secure Boot on). shim deletes SbatPolicy once it has read it.
shim_next_sbat() {
    local shim=$1 cur=$2 sec=$tmp/sbatlevel.bin policy=2 cand
    pe_section "$shim" .sbatlevel "$sec"
    [[ $(read_uint "$sec" 0 4) == 0 ]] || die "$shim: unknown .sbatlevel format"
    if [[ -r $EFIVARS/SbatPolicy-$SHIM_LOCK_GUID ]]; then
        policy=$(read_uint "$EFIVARS/SbatPolicy-$SHIM_LOCK_GUID" 4 1)
    fi
    if [[ $policy == 1 ]]; then
        read_cstring "$sec" $((4 + $(read_uint "$sec" 8 4))) cand
    else
        read_cstring "$sec" $((4 + $(read_uint "$sec" 4 4))) cand
    fi
    [[ $cand == sbat,* ]] || die "$shim: malformed .sbatlevel payload"
    if sbat_keeps "$cur" "$cand"; then
        printf -v "$3" '%s' "$cur"
    else
        printf -v "$3" '%s' "$cand"
    fi
}

# u64le N: N as 8 little-endian bytes.
u64le() {
    local h i
    h=$(printf '%016x' "$1")
    for ((i = 14; i >= 0; i -= 2)); do printf '%b' "\\x${h:i:2}"; done
}

# var_event FILE GUID NAME DATA: writes the UEFI_VARIABLE_DATA that the
# firmware and shim hash for variable events. GUID is given as its 16 bytes
# in hex, in on-disk (mixed-endian) order.
var_event() {
    local file=$1 guid=$2 name=$3 data=$4 i
    {
        for ((i = 0; i < 32; i += 2)); do printf '%b' "\\x${guid:i:2}"; done
        u64le "${#name}"
        u64le "$(printf '%s' "$data" | wc -c)"
        for ((i = 0; i < ${#name}; i++)); do printf '%s\0' "${name:i:1}"; done
        printf '%s' "$data"
    } >"$file"
}

# digest ALG FILE: prints the digest of FILE for a TPM hash algorithm name.
digest() {
    case $1 in
    sha1 | sha256 | sha384 | sha512) "${1}sum" -- "$2" | cut -d' ' -f1 ;;
    *) die "unsupported hash algorithm '$1'" ;;
    esac
}

gen_secureboot_authority() {
    local out=$1 f cur next ev=$tmp/sbat-event.bin next_ev=$tmp/sbat-event-next.bin found alg
    "$PCRLOCK" lock-secureboot-authority --pcrlock="$out"
    for f in /var/lib/pcrlock.d/*-secureboot-authority.pcrlock /var/lib/pcrlock.d/*-secureboot-authority.pcrlock.d; do
        warn "$f duplicates component '$c_name'; remove it and disable systemd-pcrlock-secureboot-authority.service"
    done
    [[ -n $c_path ]] || return 0
    [[ -r $c_path ]] || die "$c_file: $c_path not readable"

    # shim measures SbatLevel into PCR 7 as an authority event, after it may
    # have updated the variable. Find the current record by its digest, which
    # also proves the encoding, and swap in the level the new shim will set.
    efivar_text "SbatLevelRT-$SHIM_LOCK_GUID" cur ||
        die "$c_name: SbatLevelRT not found; was this boot started by shim?"
    var_event "$ev" 50ab5d6046e00043abb63dd810dd8b23 SbatLevel "$cur"
    found=$(jq --arg d "$(digest sha256 "$ev")" \
        '[.records[] | select(.pcr == 7 and any(.digests[]; .hashAlg == "sha256" and .digest == $d))] | length' "$out")
    [[ $found == 1 ]] ||
        die "$c_name: found $found PCR 7 records for the current SbatLevel, expected 1"

    shim_next_sbat "$c_path" "$cur" next
    if [[ $next == "$cur" ]]; then
        debug "$c_name: SbatLevel stays at ${cur%%$'\n'*}"
        return 0
    fi
    log "$c_name: $c_path will set SbatLevel to ${next%%$'\n'*} (now ${cur%%$'\n'*})"
    var_event "$next_ev" 50ab5d6046e00043abb63dd810dd8b23 SbatLevel "$next"
    for alg in $(jq -r '[.records[].digests[].hashAlg] | unique | .[]' "$out"); do
        jq -nc --arg a "$alg" --arg d "$(digest "$alg" "$next_ev")" '{hashAlg: $a, digest: $d}'
    done | jq -s . >"$tmp/sbat-digests.json"
    jq --arg d "$(digest sha256 "$ev")" --slurpfile next "$tmp/sbat-digests.json" '
        .records |= map(if .pcr == 7 and any(.digests[]; .hashAlg == "sha256" and .digest == $d)
            then {pcr, digests: [.digests[].hashAlg as $a | $next[0][] | select(.hashAlg == $a)]}
            else . end)
    ' "$out" >"$out.next"
    mv -f -- "$out.next" "$out"
}

gen_copy() {
    [[ -n $c_source ]] || die "$c_file: Source= missing"
    [[ -r $c_source ]] || die "$c_file: $c_source not readable"
    jq -e '.records | type == "array"' "$c_source" >/dev/null ||
        die "$c_file: $c_source is not a pcrlock file"
    cp -- "$c_source" "$1"
}

# install_variant NEW TARGET KEEP_PREVIOUS
# Installs NEW as TARGET if it differs. With KEEP_PREVIOUS, an existing TARGET
# that matches the current boot is kept as <name>-previous.pcrlock, so the
# policy still covers the running system until the next reboot.
install_variant() {
    local new=$1 target=$2 keep=$3 prev
    if [[ -f $target ]] && cmp -s -- "$new" "$target"; then
        debug "${target#"$opt_dir"/}: unchanged"
        return 0
    fi

    prev=${target%.pcrlock}-previous.pcrlock
    if ((dry_run)); then
        if [[ $keep == yes && -f $target ]] && is_booted "$target"; then
            log "would keep ${target#"$opt_dir"/} as ${prev##*/}"
        fi
        log "would update ${target#"$opt_dir"/}"
        : >"$tmp/changed"
        return 0
    fi

    mkdir -p -- "${target%/*}"
    if [[ $keep == yes && -f $target ]] && is_booted "$target"; then
        mv -f -- "$target" "$prev"
        log "kept ${target#"$opt_dir"/} as ${prev##*/} (matches the current boot)"
    fi
    install -m 0644 -- "$new" "$target.tmp"
    mv -f -- "$target.tmp" "$target"
    log "updated ${target#"$opt_dir"/}"
    : >"$tmp/changed"
}

run_component() {
    local out=$tmp/new-$c_prio-$c_name.pcrlock target got keep=no
    target=$(component_target)
    if is_yes "$c_keep_previous"; then
        keep=yes
        [[ ${target%/*} == *.pcrlock.d ]] ||
            die "$c_file: KeepPrevious=yes needs the output inside a <name>.pcrlock.d directory"
    fi

    case $c_type in
    pe) gen_pe "$out" ;;
    log) gen_log "$out" ;;
    volume-key) gen_volume_key "$out" ;;
    identity) gen_identity "$out" ;;
    raw) gen_raw "$out" ;;
    platsec) gen_platsec "$out" ;;
    copy) gen_copy "$out" ;;
    secureboot-policy) gen_secureboot_policy "$out" ;;
    secureboot-authority) gen_secureboot_authority "$out" ;;
    esac

    got=$(jq '.records | length' "$out") || die "$c_name: generated file is not valid JSON"
    ((got >= c_min_records)) ||
        die "$c_name: produced $got record(s), expected at least $c_min_records; keeping the existing file"
    debug "$c_name: $got record(s)"
    install_variant "$out" "$target" "$keep"
}

# pcr_list LIST...: expands PCR lists ("0-5,7", "0+7", "0 1 11") into one
# number per line, sorted and unique.
pcr_list() {
    local w items
    for w in "$@"; do
        IFS=', +' read -ra items <<<"$w"
        printf '%s\n' "${items[@]}"
    done | jq -Rn '[inputs | select(length > 0)
        | if test("^[0-9]+-[0-9]+$") then (split("-") | map(tonumber) | range(.[0]; .[1] + 1))
          elif test("^[0-9]+$") then tonumber
          else error("invalid PCR \(.)") end] | unique | .[]' || die "invalid PCR list: $*"
}

# read_pcrs VAR LIST...: sets array VAR to the expanded PCR lists. Not via
# process substitution, so an invalid list stops the caller.
read_pcrs() {
    local out
    out=$(pcr_list "${@:2}") || exit 1
    [[ -n $out ]] || die "empty PCR list"
    mapfile -t "$1" <<<"$out"
}

# make_policy_argv: sets mp_argv to the make-policy unit's ExecStart= command
# line, mp_location to its --location= and mp_pcrs to the PCRs it covers.
make_policy_argv() {
    local args w
    local -a pcrs=()
    args=$(systemctl show -P ExecStart "$MAKE_POLICY_UNIT" 2>/dev/null |
        sed -n 's/.*argv\[\]=\([^;]*\) ;.*/\1/p' | tail -n 1) || true
    read -ra mp_argv <<<"$args"
    mp_location=$PCRLOCK_DEFAULT_LOCATION
    for w in "${mp_argv[@]}"; do
        case $w in
        --location=*) mp_location=${w#*=} ;;
        --pcr=*) pcrs+=("${w#*=}") ;;
        esac
    done
    read_pcrs mp_pcrs "${pcrs[@]:-$DEFAULT_PCRS}"
}

# pcr_value_counts: prints "PCR<TAB>VALUES" for every PCR the policy covers.
# Mirrors make-policy: components before the --location= start are always
# measured, the boot may stop after any component up to the end, and later
# ones are ignored. Each stop adds the product of the variant counts so far
# (counting variants that differ on that PCR), unless the component doesn't
# touch the PCR. That's an upper bound; coinciding values aren't detected.
pcr_value_counts() {
    local start end id path mask_json
    make_policy_argv
    start=${mp_location%%:*}
    end=${mp_location#*:}
    mask_json=$(printf '%s\n' "${mp_pcrs[@]}" | jq -sc .)
    debug "counting PCR values for --location=$start:$end, PCRs ${mp_pcrs[*]}"

    "$PCRLOCK" list-components --json=short >"$tmp/components.json" ||
        die "systemd-pcrlock list-components failed"
    : >"$tmp/variants.jsonl"
    while IFS=$'\t' read -r id path; do
        jq -c --arg id "$id" '{id: $id, recs: [.records[]?
            | {pcr, d: ([.digests[]? | select(.hashAlg == "sha256") | .digest] | first)}]}' \
            "$path" >>"$tmp/variants.jsonl" || die "$path: not a pcrlock file"
    done < <(jq -r '.[] | .id as $id
        | (.variants | if type == "array" then .[] else . end) | [$id, .] | @tsv' "$tmp/components.json")

    # shellcheck disable=SC2016
    jq -rs --arg start "$start" --arg end "$end" --argjson mask "$mask_json" '
        group_by(.id) as $comps
        | [$comps[][].recs[].pcr] | unique | .[]
        | . as $p
        | select(any($mask[]; . == $p))
        | [$comps[] | {id: .[0].id,
                       n: ([.[] | [.recs[] | select(.pcr == $p) | .d]] | unique | length),
                       touches: any(.[].recs[]; .pcr == $p)}] as $c
        | (reduce ($c[] | select(.id < $start) | .n) as $n (1; . * $n)) as $pre
        | (reduce ($c[] | select(.id >= $start and .id <= $end and .touches)) as $w
            ({acc: $pre, total: $pre}; .acc *= $w.n | .total += .acc)).total
        | "\($p)\t\(.)"
    ' "$tmp/variants.jsonl"
}

# check_location: fails if make-policy doesn't use the configured --location=.
# This tool only restarts the unit, so the option has to be in its drop-in.
check_location() {
    make_policy_argv
    [[ $mp_location != "$opt_location" ]] || return 0
    warn "$MAKE_POLICY_UNIT uses --location=$mp_location, but Location= is $opt_location"
    warn "add it to the unit with 'systemctl edit $MAKE_POLICY_UNIT':"
    warn "  [Service]"
    warn "  ExecStart="
    warn "  ExecStart=/usr/lib/systemd/systemd-pcrlock make-policy --location=$opt_location --strict=yes"
    return 1
}

# check_budget: fails if a PCR could take more values than one PolicyOR holds.
check_budget() {
    local pcr n over=0 counts
    counts=$(pcr_value_counts) || exit 1
    while IFS=$'\t' read -r pcr n; do
        [[ -n $pcr ]] || continue
        debug "PCR $pcr: $n possible value(s)"
        if ((n > MAX_PCR_VALUES)); then
            warn "PCR $pcr can take $n values, more than the $MAX_PCR_VALUES a policy can hold"
            over=1
        fi
    done <<<"$counts"
    ((!over)) || warn "drop variants (e.g. 'pcrlock prune' after a reboot) or merge components; see 'pcrlock check'"
    ((!over))
}

apply_policy() {
    local mode=${policy_cli:-$opt_policy}
    ((!no_apply)) || return 0
    if [[ -e $tmp/changed ]]; then changed=1; fi
    if ((!changed)); then
        debug "nothing changed, policy left alone"
        return 0
    fi
    if ((dry_run)); then
        log "would update the policy ($mode)"
        return 0
    fi
    # make-policy would fail on too many branches anyway, but without saying
    # which components caused it.
    if ! check_location || ! check_budget; then
        [[ $mode == none ]] || die "not updating the policy; the current one stays in place"
        return 0
    fi
    case $mode in
    now)
        log "updating the policy ($MAKE_POLICY_UNIT)"
        systemctl restart "$MAKE_POLICY_UNIT"
        ;;
    mark)
        systemctl set-property --runtime "$MAKE_POLICY_UNIT" Markers=needs-start
        log "marked $MAKE_POLICY_UNIT for restart"
        ;;
    none)
        log "components changed; run 'systemctl restart $MAKE_POLICY_UNIT' to update the policy"
        ;;
    esac
}

component_files() {
    local f
    for f in "$config_dir"/components.d/*.conf; do
        printf '%s\n' "$f"
    done
}

# ---------------------------------------------------------------------------
# Commands

cmd_generate() {
    local f rc name failed=0 matched=0
    local -A wanted=() seen=()
    for name in "$@"; do wanted[$name]=1; done

    mapfile -t files < <(component_files)
    for f in "${files[@]}"; do
        load_component "$f"
        [[ -z ${seen[$c_name]:-} ]] || die "$f: duplicate component name '$c_name'"
        seen[$c_name]=1
    done
    for name in "${!wanted[@]}"; do
        [[ -n ${seen[$name]:-} ]] || die "no such component: $name"
    done

    for f in "${files[@]}"; do
        load_component "$f"
        if ((${#wanted[@]})) && [[ -z ${wanted[$c_name]:-} ]]; then continue; fi
        if [[ -n $type_filter && ,$type_filter, != *,"$c_type",* ]]; then continue; fi
        if ! is_yes "$c_enabled"; then
            debug "$c_name: disabled"
            continue
        fi
        matched=$((matched + 1))
        # Each component runs in a subshell, so one failing component (e.g. a
        # volume not unlocked this boot) doesn't stop the others.
        set +e
        (set -e; run_component)
        rc=$?
        set -e
        if ((rc != 0)); then failed=$((failed + 1)); fi
    done

    if ((matched == 0)); then
        debug "no matching components"
    fi
    apply_policy
    ((failed == 0)) || die "$failed component(s) failed; their existing files were kept"
}

cmd_list() {
    local f target state
    suspend_notice
    printf '%-5s %-24s %-11s %-9s %s\n' PRIO NAME TYPE STATE OUTPUT
    while IFS= read -r f; do
        load_component "$f"
        target=$(component_target)
        if ! is_yes "$c_enabled"; then
            state=disabled
        elif [[ ! -f $target ]]; then
            state=missing
        elif is_booted "$target"; then
            state=booted
        else
            state=present
        fi
        printf '%-5s %-24s %-11s %-9s %s\n' "$c_prio" "$c_name" "$c_type" "$state" "${target#"$opt_dir"/}"
    done < <(component_files)
}

remove_file() {
    if ((dry_run)); then
        log "would remove ${1#"$opt_dir"/} ($2)"
    else
        rm -f -- "$1"
        log "removed ${1#"$opt_dir"/} ($2)"
    fi
    : >"$tmp/changed"
}

cmd_prune() {
    local f kver
    for f in "$opt_dir"/*.pcrlock.d/*-previous.pcrlock; do
        if is_booted "$f"; then
            debug "${f#"$opt_dir"/}: matches the current boot, keeping"
        else
            remove_file "$f" "previous variant, not booted"
        fi
    done

    # UKI variants are named <kernel version>.pcrlock.
    for f in "$opt_dir/$opt_uki_component.pcrlock.d"/*.pcrlock; do
        kver=${f##*/}
        kver=${kver%.pcrlock}
        [[ $kver == *-previous ]] && continue # handled above
        [[ -d /usr/lib/modules/$kver ]] && continue
        if is_booted "$f"; then
            debug "${f#"$opt_dir"/}: kernel $kver is gone but this is the current boot, keeping"
        else
            remove_file "$f" "kernel $kver no longer installed"
        fi
    done

    apply_policy
}

cmd_check() {
    local pcr n state over=0 counts
    suspend_notice
    check_location || over=1
    counts=$(pcr_value_counts) || exit 1
    printf '%-4s %-7s %s\n' PCR VALUES STATE
    while IFS=$'\t' read -r pcr n; do
        [[ -n $pcr ]] || continue
        state=ok
        if ((n > MAX_PCR_VALUES)); then
            state="over the limit (max $MAX_PCR_VALUES)"
            over=1
        elif ((n == MAX_PCR_VALUES)); then
            # Still valid, but the next -previous variant on this PCR is
            # refused.
            state="at the limit, no room for another variant"
        fi
        printf '%-4s %-7s %s\n' "$pcr" "$n" "$state"
    done <<<"$counts"
    ((!over))
}

# suspend_notice: warns while the firmware PCRs are out of the policy.
suspend_notice() {
    if [[ -e $SUSPEND_STATE ]]; then
        warn "firmware PCRs are suspended ($(tr '\n' ' ' <"$SUSPEND_STATE")); run '$PROG relock-firmware'"
    fi
}

# pending_capsules: prints what fwupd's uefi-capsule plugin staged for the next
# boot, one line each, and fails if nothing is. Two methods:
# - fwupd.efi: fwupd-<class>-<hw_inst> holds EFI_UPDATE_INFO; status (u32 at
#   48, after the 4 bytes of efivarfs attributes) 1 is ATTEMPT_UPDATE.
# - capsule on disk: OsIndications bit 2 (FILE_CAPSULE_DELIVERY_SUPPORTED).
# The capsule files on the ESP follow with size and mtime, so that staging an
# update again gives a new fingerprint.
pending_capsules() {
    local f v esp n=0
    for f in "$EFIVARS"/fwupd-*-"$FWUPD_GUID"; do
        v=$(od -An -tu4 --endian=little -j 52 -N 4 -- "$f")
        if [[ ${v//[[:space:]]/} == 1 ]]; then
            echo "efivar ${f##*/}"; n=$((n + 1))
        fi
    done
    f=$EFIVARS/OsIndications-$EFI_GLOBAL_GUID
    v=
    [[ ! -e $f ]] || v=$(od -An -tu1 -j 4 -N 1 -- "$f")
    v=${v//[[:space:]]/}
    if ((${v:-0} & 4)); then
        echo "efivar ${f##*/} capsule-on-disk"; n=$((n + 1))
    fi
    ((n)) || return 1
    if esp=$(bootctl --print-esp-path 2>/dev/null) && [[ -d $esp/EFI ]]; then
        find "$esp/EFI" -maxdepth 3 -type f \
            \( -ipath '*/UpdateCapsule/*' -o -ipath '*/fw/fwupd-*.cap' \) \
            -printf 'file %P %s %T@\n' | sort
    else
        warn "can't find the ESP; a capsule staged again would look the same"
    fi
}

# capsule_check: for --if-capsule-pending. Succeeds (and sets capsule_fp) if a
# capsule update is staged and no suspension was made for it yet.
capsule_check() {
    if [[ -e $SUSPEND_STATE ]]; then
        log "firmware PCRs are already suspended"
        return 1
    fi
    if ! pending_capsules >"$tmp/capsules"; then
        log "no UEFI capsule update is staged"
        return 1
    fi
    capsule_fp=$(sha256sum <"$tmp/capsules")
    capsule_fp=${capsule_fp%% *}
    if [[ -e $CAPSULE_STATE && $(<"$CAPSULE_STATE") == "$capsule_fp" ]]; then
        warn "the staged capsule update was already suspended for once and is still pending ($(paste -sd ';' "$tmp/capsules")); not suspending again. Stage it again if the firmware didn't apply it."
        return 1
    fi
    log "UEFI capsule update staged: $(paste -sd ';' "$tmp/capsules")"
}

cmd_suspend_firmware() {
    local p w
    local -a want suspend=() keep=() argv=()
    ((!dry_run)) || die "suspend-firmware doesn't support --dry-run"
    if ((if_capsule_pending)); then
        capsule_check || return 0
    fi
    systemctl is-enabled --quiet "$RELOCK_UNIT" ||
        die "$RELOCK_UNIT is not enabled, so the firmware PCRs would stay out of the policy after the update; run 'systemctl enable $RELOCK_UNIT' first"
    read_pcrs want "${@:-$opt_suspend_pcrs}"
    if [[ -e $SUSPEND_DROPIN ]]; then
        # Start from the real command line again.
        rm -f -- "$SUSPEND_DROPIN"
        systemctl daemon-reload
    fi
    make_policy_argv
    ((${#mp_argv[@]})) || die "can't read ExecStart= of $MAKE_POLICY_UNIT"
    for p in "${mp_pcrs[@]}"; do
        if [[ " ${want[*]} " == *" $p "* ]]; then suspend+=("$p"); else keep+=("$p"); fi
    done
    ((${#suspend[@]})) || die "none of PCRs ${want[*]} is in the policy (PCRs ${mp_pcrs[*]})"
    for w in "${mp_argv[@]}"; do
        [[ $w == --pcr=* ]] || argv+=("${w//%/%%}")
    done
    for p in "${keep[@]}"; do argv+=("--pcr=$p"); done

    mkdir -p -- "${SUSPEND_DROPIN%/*}" "${SUSPEND_STATE%/*}"
    printf '%s\n' "# Written by '$PROG suspend-firmware'. Gone after a reboot;" \
        "# '$PROG relock-firmware' removes it right away." \
        '[Service]' 'ExecStart=' "ExecStart=${argv[*]}" >"$SUSPEND_DROPIN"
    (IFS=,; printf 'PCRs=%s\nSince=%s\n' "${suspend[*]}" "$(date -Iseconds)") >"$SUSPEND_STATE"
    systemctl daemon-reload
    log "rebuilding the policy without PCRs ${suspend[*]}"
    if ! systemctl restart "$MAKE_POLICY_UNIT"; then
        rm -f -- "$SUSPEND_DROPIN" "$SUSPEND_STATE"
        systemctl daemon-reload
        die "$MAKE_POLICY_UNIT failed; nothing was suspended"
    fi
    if [[ -n $capsule_fp ]]; then
        echo "$capsule_fp" >"$CAPSULE_STATE"
        log "PCRs ${suspend[*]} are out of the policy for the staged update; $RELOCK_UNIT locks them again on the next boot."
    else
        log "PCRs ${suspend[*]} are out of the policy until they are locked again. Stage the firmware update now; $RELOCK_UNIT locks them again on the next boot."
    fi
}

suspend_kv() {
    case $1 in
    PCRs) suspended_pcrs=$2 ;;
    Since) ;;
    *) die "$3: unknown key '$1'" ;;
    esac
}

cmd_relock_firmware() {
    local id path p f suspended_pcrs=$opt_suspend_pcrs code=0 config=0
    local -a pcrs names=() stale=()
    local -A varlib=() touches=() booted=()
    ((!dry_run)) || die "relock-firmware doesn't support --dry-run"
    if [[ -e $SUSPEND_DROPIN ]]; then
        rm -f -- "$SUSPEND_DROPIN"
        systemctl daemon-reload
        log "removed the runtime override of $MAKE_POLICY_UNIT"
    elif [[ ! -e $SUSPEND_STATE ]]; then
        log "firmware PCRs aren't suspended, nothing to do"
        return 0
    fi
    if [[ -e $SUSPEND_STATE ]]; then
        parse_kv_file "$SUSPEND_STATE" suspend_kv
    fi
    read_pcrs pcrs "$suspended_pcrs"
    log "locking PCRs ${pcrs[*]} again from the current event log"

    # systemd's own firmware components, if they are in use: lock-firmware-code
    # covers PCRs 0 and 2, lock-firmware-config PCRs 1 and 3.
    "$PCRLOCK" list-components --json=short >"$tmp/components.json" ||
        die "systemd-pcrlock list-components failed"
    while IFS=$'\t' read -r id path; do
        [[ $path == /var/lib/pcrlock.d/* ]] && varlib[$id]=1
    done < <(jq -r '.[] | .id as $id | (.variants | if type == "array" then .[] else . end) | [$id, .] | @tsv' "$tmp/components.json")
    for id in "${!varlib[@]}"; do
        case $id in
        *-firmware-code*) code=1 ;;
        *-firmware-config*) config=1 ;;
        esac
    done
    for p in "${pcrs[@]}"; do
        case $p in
        0 | 2) ((code)) && code=2 ;;
        1 | 3) ((config)) && config=2 ;;
        esac
    done
    if ((code == 2)); then
        log "running systemd-pcrlock lock-firmware-code"
        "$PCRLOCK" lock-firmware-code
    fi
    if ((config == 2)); then
        log "running systemd-pcrlock lock-firmware-config"
        "$PCRLOCK" lock-firmware-config
    fi

    # The toolkit's own log components on these PCRs.
    while IFS= read -r f; do
        load_component "$f"
        if [[ $c_type == log ]] && is_yes "$c_enabled" && [[ " ${pcrs[*]} " == *" $c_pcr "* ]]; then
            names+=("$c_name")
        fi
    done < <(component_files)
    if ((${#names[@]})); then
        no_apply=1
        cmd_generate "${names[@]}"
        no_apply=0
    fi

    # Anything else on these PCRs (e.g. hand-made variants) must still match.
    "$PCRLOCK" list-components --json=short >"$tmp/components.json" ||
        die "systemd-pcrlock list-components failed"
    while IFS=$'\t' read -r id path; do
        if jq -e --argjson p "$(printf '%s\n' "${pcrs[@]}" | jq -sc .)" \
            'any(.records[]?; .pcr as $r | $p | index($r) != null)' "$path" >/dev/null 2>&1; then
            touches[$id]=1
            if is_booted "$path"; then booted[$id]=1; fi
        fi
    done < <(jq -r '.[] | .id as $id | (.variants | if type == "array" then .[] else . end) | [$id, .] | @tsv' "$tmp/components.json")
    for id in "${!touches[@]}"; do
        [[ -n ${booted[$id]:-} ]] || stale+=("$id")
    done
    ((${#stale[@]} == 0)) ||
        die "no variant of ${stale[*]} matches this boot; update them, then run '$PROG relock-firmware' again (PCRs ${pcrs[*]} stay suspended)"

    { check_location && check_budget; } || die "PCRs ${pcrs[*]} stay suspended"
    log "rebuilding the full policy"
    systemctl restart "$MAKE_POLICY_UNIT" ||
        die "$MAKE_POLICY_UNIT failed; PCRs ${pcrs[*]} stay suspended, see 'systemd-pcrlock log'"
    rm -f -- "$SUSPEND_STATE"
    log "PCRs ${pcrs[*]} are locked again"
}

# cmd_volume_keys: systemd-cryptsetup measures HMAC(volume key,
# "cryptsetup:<name>:<uuid>") with tpm2-measure-pcr=yes. Its sha256 digest is
# what fixate-volume-key= in crypttab expects, independent of how the volume
# was unlocked. The NvPCR keyslot record (tpm2-measure-keyslot-nvpcr=) is the
# one that names the unlock method and keyslot.
cmd_volume_keys() {
    local keys slots name uuid digest how state o
    local -a opts hints=()
    local -A unlock=() fixed=() listed=()
    local mismatch=0
    ensure_cel
    keys=$(jq -r '.[] | select(.content.eventType? == "volume-key")
        | (.content.string | split(":")) as $f
        | [$f[1], ($f[2:] | join(":")),
           ([.digests[] | select(.hashAlg == "sha256") | .digest][0] // "-")]
        | @tsv' "$CEL") || die "can't read the volume-key records"
    slots=$(jq -r '.[] | select(.content.eventType? == "keyslot")
        | .content.string | split(":") | [.[1], (.[3:] | join(":"))] | @tsv' "$CEL") ||
        die "can't read the keyslot records"
    while IFS=$'\t' read -r name how; do
        [[ -n $name ]] && unlock[$name]=$how
    done <<<"$slots"
    if [[ -r $CRYPTTAB ]]; then
        while read -r name _ _ o _; do
            [[ -n $name && $name != \#* ]] || continue
            listed[$name]=1
            IFS=, read -ra opts <<<"${o:-}"
            for o in "${opts[@]}"; do
                [[ $o == fixate-volume-key=* ]] && fixed[$name]=${o#*=}
            done
        done <"$CRYPTTAB"
    fi
    if [[ -z $keys ]]; then
        log "no volume keys measured this boot (tpm2-measure-pcr=yes in $CRYPTTAB?)"
        return 0
    fi

    printf '%-12s %-10s %-14s %s\n' VOLUME UNLOCKED CRYPTTAB DIGEST
    while IFS=$'\t' read -r name uuid digest; do
        if [[ -z ${listed[$name]:-} ]]; then
            state="no entry"
        elif [[ -z ${fixed[$name]:-} ]]; then
            state="not fixed"
            hints+=("$name: fixate-volume-key=$digest")
        elif [[ ${fixed[$name],,} == "${digest,,}" ]]; then
            state=fixed
        else
            state=MISMATCH
            mismatch=1
        fi
        printf '%-12s %-10s %-14s %s\n' "$name" "${unlock[$name]:--}" "$state" "$digest"
        debug "$name: LUKS UUID $uuid"
    done <<<"$keys"
    if ((${#hints[@]})); then
        echo
        echo "To pin them, add to the options in $CRYPTTAB:"
        printf '  %s\n' "${hints[@]}"
    fi
    ((!mismatch)) || warn "a fixate-volume-key= in $CRYPTTAB doesn't match the measured volume key"
    ((!mismatch))
}

# valid_kver KVER: a kernel version usable as a variant file name. "-previous"
# is reserved for the kept variant of the running kernel.
valid_kver() {
    [[ -n $1 && $1 != */* && $1 != .* ]] || die "invalid kernel version '$1'"
    [[ $1 != *-previous ]] || die "kernel version '$1' clashes with the -previous variant name"
}

cmd_uki() {
    local sub=${1:-} kver dir target out
    shift || true
    case $sub in
    add)
        (($# >= 2 && $# <= 3)) || die "usage: $PROG uki add KVER UKI [KERNEL]"
        kver=$1
        valid_kver "$kver"
        [[ -r $2 ]] || die "$2 not readable"
        [[ -z ${3:-} || -r $3 ]] || die "$3 not readable"
        dir=$opt_dir/$opt_uki_component.pcrlock.d
        target=$dir/$kver.pcrlock
        out=$tmp/uki-merged.pcrlock
        "$PCRLOCK" lock-uki "$2" --pcrlock="$tmp/uki.pcrlock"
        if [[ -n ${3:-} ]]; then
            # systemd-stub loads the embedded kernel via LoadImage(), which the
            # firmware measures into PCR 4 as a separate event.
            "$PCRLOCK" lock-pe "$3" --pcrlock="$tmp/uki-kernel.pcrlock"
            jq -s '{records: (.[0].records + .[1].records)}' \
                "$tmp/uki.pcrlock" "$tmp/uki-kernel.pcrlock" >"$out"
        else
            cp -- "$tmp/uki.pcrlock" "$out"
        fi
        install_variant "$out" "$target" yes
        ;;
    remove)
        (($# == 1)) || die "usage: $PROG uki remove KVER"
        valid_kver "$1"
        target=$opt_dir/$opt_uki_component.pcrlock.d/$1.pcrlock
        if [[ ! -e $target ]]; then
            debug "${target#"$opt_dir"/} not present, nothing to do"
        elif is_booted "$target"; then
            # kernel-install removes the old kernel when a new one is installed,
            # usually the running one. Dropping its variant would leave the
            # running system outside the policy; prune removes it after reboot.
            log "kept ${target#"$opt_dir"/}: kernel $1 is the current boot; '$PROG prune' removes it after the next boot"
        else
            remove_file "$target" "kernel $1 removed"
        fi
        ;;
    *) die "usage: $PROG uki add|remove ..." ;;
    esac
    apply_policy
}

# ---------------------------------------------------------------------------

main() {
    local args=() cmd
    # decode has its own options and reads files, so it needs no root and
    # skips the rest.
    if [[ ${1:-} == decode ]]; then
        exec "$CEL_DECODE" "${@:2}"
    fi
    while (($#)); do
        case $1 in
        --dry-run) dry_run=1 ;;
        --if-capsule-pending) if_capsule_pending=1 ;;
        -v | --verbose) verbose=1 ;;
        --policy=*) policy_cli=${1#*=} ;;
        --type=*) type_filter=${1#*=} ;;
        --config-dir=*) config_dir=${1#*=} ;;
        -h | --help) usage; exit 0 ;;
        --version) echo "$PROG $VERSION"; exit 0 ;;
        --) shift; args+=("$@"); break ;;
        -*) die "unknown option: $1 (see --help)" ;;
        *) args+=("$1") ;;
        esac
        shift
    done
    ((${#args[@]})) || { usage >&2; exit 2; }
    cmd=${args[0]}
    args=("${args[@]:1}")

    case $policy_cli in '' | now | mark | none) ;; *) die "--policy must be now, mark or none" ;; esac
    ((!if_capsule_pending)) || [[ $cmd == suspend-firmware ]] ||
        die "--if-capsule-pending only applies to suspend-firmware"
    ((EUID == 0)) || die "must be run as root (the event log and $(printf %q "$opt_dir") need it)"

    load_global
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    CEL=$tmp/cel.json

    case $cmd in
    generate) cmd_generate "${args[@]}" ;;
    list) ((${#args[@]} == 0)) || die "list takes no arguments"; cmd_list ;;
    prune) ((${#args[@]} == 0)) || die "prune takes no arguments"; cmd_prune ;;
    uki) cmd_uki "${args[@]}" ;;
    check) ((${#args[@]} == 0)) || die "check takes no arguments"; cmd_check ;;
    suspend-firmware) cmd_suspend_firmware "${args[@]}" ;;
    relock-firmware) ((${#args[@]} == 0)) || die "relock-firmware takes no arguments"; cmd_relock_firmware ;;
    volume-keys) ((${#args[@]} == 0)) || die "volume-keys takes no arguments"; cmd_volume_keys ;;
    help) usage ;;
    *) die "unknown command: $cmd (see --help)" ;;
    esac
}

main "$@"
