#!/usr/bin/python3
"""Stub systemd-pcrlock for the tests. Logs every call to $STUB_ROOT/calls.log.

- cel: prints $STUB_ROOT/cel.json.
- lock-pe/lock-uki: one PCR 4 record whose digest is the file's sha256 (the
  real one hashes Authenticode, which is the same for unsigned and signed
  copies; the tests only need "different file, different digest").
- lock-raw: sha256 of stdin into --pcr=.
- lock-machine-id / lock-file-system: PCR 15 records from fixed strings.
- lock-secureboot-policy: the PCR 7 variable records built from the efivars
  in $STUB_EFIVARS with the real UEFI_VARIABLE_DATA encoding.
- lock-secureboot-authority: the PCR 7 authority records after the PCR 7
  separator in the event log, as the real one copies them.
- lock-firmware-code / lock-firmware-config: generated.pcrlock files under
  $STUB_ROOT/var/lib/pcrlock.d from PCRs 0+2 / 1+3 of the log.
- list-components --json=short: components from $STUB_COMPONENT_DIRS (":"
  separated, earlier ones override same-named later ones), sorted by id.
- Exit codes can be forced with $STUB_ROOT/fail/<verb>.
"""

import hashlib
import json
import os
import struct
import sys
import uuid

ROOT = os.environ["STUB_ROOT"]
EFIVARS = os.environ.get("STUB_EFIVARS", os.path.join(ROOT, "sys/firmware/efi/efivars"))

with open(os.path.join(ROOT, "calls.log"), "a") as f:
    f.write("systemd-pcrlock " + " ".join(sys.argv[1:]) + "\n")

verb = sys.argv[1] if len(sys.argv) > 1 else ""
if os.path.exists(os.path.join(ROOT, "fail", verb)):
    sys.exit(1)

opts = {}
pos = []
for a in sys.argv[2:]:
    if a.startswith("--") and "=" in a:
        k, v = a[2:].split("=", 1)
        opts[k] = v
    else:
        pos.append(a)


def sha256(b):
    return hashlib.sha256(b).hexdigest()


def write(records):
    doc = json.dumps({"records": records})
    if "pcrlock" in opts:
        with open(opts["pcrlock"], "w") as f:
            f.write(doc)
    else:
        print(doc)


def rec(pcr, data):
    return {"pcr": pcr, "digests": [{"hashAlg": "sha256", "digest": sha256(data)}]}


def cel():
    with open(os.path.join(ROOT, "cel.json")) as f:
        return json.load(f)


def var_event(guid, name, data):
    return (uuid.UUID(guid).bytes_le + struct.pack("<QQ", len(name), len(data))
            + name.encode("utf-16-le") + data)


if verb == "cel":
    with open(os.path.join(ROOT, "cel.json")) as f:
        sys.stdout.write(f.read())
elif verb in ("lock-pe", "lock-uki"):
    with open(pos[0], "rb") as f:
        write([rec(4, f.read())])
elif verb == "lock-raw":
    write([rec(int(opts["pcr"]), sys.stdin.buffer.read())])
elif verb == "lock-machine-id":
    write([rec(15, b"machine-id:stub")])
elif verb == "lock-file-system":
    write([rec(15, f"file-system:{pos[0]}".encode())])
elif verb == "lock-secureboot-policy":
    records = []
    for name, guid in [("SecureBoot", "8be4df61-93ca-11d2-aa0d-00e098032b8c"),
                       ("PK", "8be4df61-93ca-11d2-aa0d-00e098032b8c"),
                       ("KEK", "8be4df61-93ca-11d2-aa0d-00e098032b8c"),
                       ("db", "d719b2cb-3d3a-4596-a3bc-dad00e67656f"),
                       ("dbx", "d719b2cb-3d3a-4596-a3bc-dad00e67656f")]:
        try:
            with open(os.path.join(EFIVARS, f"{name}-{guid}"), "rb") as f:
                data = f.read()[4:]
        except FileNotFoundError:
            data = b""
        ev = var_event(guid, name, data)
        records.append({"pcr": 7, "digests": [{"hashAlg": "sha256", "digest": sha256(ev)}],
                        "content": {"event_type": "EV_EFI_VARIABLE_DRIVER_CONFIG",
                                    "event_data": ev.hex()}})
    write(records)
elif verb == "lock-secureboot-authority":
    seen_sep = False
    out = []
    for r in cel():
        if r.get("pcr") != 7:
            continue
        et = (r.get("content") or {}).get("event_type")
        if et == "EV_SEPARATOR":
            seen_sep = True
        elif seen_sep and et == "EV_EFI_VARIABLE_AUTHORITY":
            out.append({k: r[k] for k in ("pcr", "digests", "content")})
    write(out)
elif verb in ("lock-firmware-code", "lock-firmware-config"):
    pcrs = (0, 2) if verb == "lock-firmware-code" else (1, 3)
    kind = verb[len("lock-"):]
    records = [{k: r[k] for k in ("pcr", "digests")} for r in cel() if r.get("pcr") in pcrs]
    d = os.path.join(ROOT, f"var/lib/pcrlock.d/250-{kind}-early.pcrlock.d")
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, "generated.pcrlock"), "w") as f:
        json.dump({"records": records}, f)
elif verb == "list-components":
    # Like the real one (checked on aurora with systemd 262): one object per
    # variant with "variants" as a string, ids repeated, sorted by id and
    # then variant file name. A top-level <id>.pcrlock is overridden by the
    # same file name in a higher-priority directory, and so is each variant
    # file in <id>.pcrlock.d/, one by one: /etc's 600-0xffffffff.pcrlock
    # replaces only that variant of /usr/lib's 500-separator. A symlink to
    # /dev/null masks the file.
    chosen = {}
    for d in os.environ.get("STUB_COMPONENT_DIRS", "").split(":"):
        if not os.path.isdir(d):
            continue
        for e in os.listdir(d):
            p = os.path.join(d, e)
            if e.endswith(".pcrlock") and not os.path.isdir(p):
                chosen.setdefault((e[:-len(".pcrlock")], ""), p)
            elif e.endswith(".pcrlock.d") and os.path.isdir(p):
                for v in os.listdir(p):
                    if v.endswith(".pcrlock"):
                        chosen.setdefault((e[:-len(".pcrlock.d")], v), os.path.join(p, v))
    print(json.dumps([{"id": cid, "variants": path}
                      for (cid, _), path in sorted(chosen.items())
                      if os.path.realpath(path) != "/dev/null"]))
else:
    sys.exit(f"stub systemd-pcrlock: unsupported verb {verb!r}")
